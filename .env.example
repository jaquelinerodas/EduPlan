# =============================================================================
#  EduPlan · Variables de entorno
#  1. Copia este archivo:   cp .env.example .env
#  2. Cambia TODOS los valores "cambiar_..." por valores reales.
#  3. NUNCA subas el archivo .env a GitHub (ya está en .gitignore).
# =============================================================================

# ---------- PostgreSQL (Fase 1) ----------
POSTGRES_DB=eduplan
POSTGRES_USER=eduplan_admin
POSTGRES_PASSWORD=cambiar_password_admin
# Puerto en TU máquina para DBeaver/pgAdmin. Solo se abre si levantas con
# docker-compose.dev.yml (dentro de Docker siempre es 5432)
POSTGRES_HOST_PORT=5433

# Usuario de BD exclusivo de cada microservicio (solo ve su esquema)
MS_AUTH_DB_PASSWORD=cambiar_password_ms_auth
MS_ACADEMICO_DB_PASSWORD=cambiar_password_ms_academico

# Cadenas de conexión que usará cada microservicio (host = nombre del servicio en Docker)
MS_AUTH_DATABASE_URL=postgresql://ms_auth:cambiar_password_ms_auth@postgres:5432/eduplan
MS_ACADEMICO_DATABASE_URL=postgresql://ms_academico:cambiar_password_ms_academico@postgres:5432/eduplan

# ---------- ms-auth (Fase 2) ----------
# development = habilita la página /auth/prueba | production = la oculta (usar al desplegar)
NODE_ENV=development
# Se obtienen en Google Cloud Console > Google Auth Platform > Clientes
GOOGLE_CLIENT_ID=cambiar_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=cambiar_client_secret
# Debe estar registrada en Google Cloud Console (URI de redireccionamiento autorizado).
# Desde la Fase 5 la aplicación usa HTTPS.
GOOGLE_CALLBACK_URL=https://localhost/auth/google/callback
# Mínimo 32 caracteres aleatorios
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=2h
# A dónde regresa el usuario con su token después de iniciar sesión (el frontend)
FRONTEND_URL=https://localhost/

# ---------- Nginx (Fases 4 y 5) ----------
# Puertos de la aplicación en tu máquina. HTTP (80) solo redirige a HTTPS (443).
# Si el 443 está ocupado usa 8443, y entonces cambia también GOOGLE_CALLBACK_URL
# y FRONTEND_URL a https://localhost:8443/...
HTTP_PORT=80
HTTPS_PORT=443
# Dominio para el certificado autofirmado. En producción, tu dominio real (ej. eduplan.com)
DOMINIO=localhost

# ---------- ms-academico (Fase 3) ----------
# Proveedor: gemini | claude | openai | simulado (simulado = sin clave, para pruebas)
AI_PROVIDER=gemini
# Clave de Google AI Studio (aistudio.google.com) si el proveedor es gemini
AI_API_KEY=cambiar_api_key_del_modelo
# Opcional: modelo a usar. Vacío = gemini-3.5-flash-lite
AI_MODEL=
