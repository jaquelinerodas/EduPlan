# =============================================================================
#  EduPlan · Nginx (proxy inverso) · Fase 5: HTTPS
#  Punto único de entrada (RF10). Es el ÚNICO contenedor con puertos abiertos:
#    http  :80   -> redirige todo a https
#    https :443  -> /        frontend (archivos estáticos)
#                   /auth/   ms-auth:3001
#                   /api/    ms-academico:3002
#  Plantilla: al arrancar, la imagen de Nginx reemplaza ${HTTPS_PORT} con el
#  valor del .env y genera /etc/nginx/conf.d/default.conf.
# =============================================================================

# HSTS solo con un dominio real: en localhost obligaría a usar https en
# todos tus proyectos locales.
map $host $eduplan_hsts {
    default     "max-age=31536000";
    localhost   "";
    127.0.0.1   "";
}

# Límite de peticiones por IP (respuesta 429 en JSON)
limit_req_zone $binary_remote_addr zone=eduplan_api:10m    rate=30r/s;
limit_req_zone $binary_remote_addr zone=eduplan_acceso:10m rate=10r/m;
limit_req_status 429;

# ---------- HTTP: solo redirige a HTTPS ----------
server {
    listen 80;
    server_name _;
    server_tokens off;

    # Validación de Let's Encrypt (certbot) cuando se despliega con dominio real
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    # Revisión de salud del contenedor (healthcheck de Docker)
    location = /salud {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location / {
        return 301 https://$host:${HTTPS_PORT}$request_uri;
    }
}

# ---------- HTTPS ----------
server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/eduplan.crt;
    ssl_certificate_key /etc/nginx/certs/eduplan.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:EDUPLAN_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header Strict-Transport-Security $eduplan_hsts always;

    # Datos comunes que reciben los microservicios
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Respuesta del límite de peticiones con el mismo formato de error de la API
    error_page 429 = @demasiadas;
    location @demasiadas {
        default_type application/json;
        add_header Retry-After 60 always;
        return 429 '{"error":{"codigo":"DEMASIADAS_PETICIONES","mensaje":"Demasiadas solicitudes seguidas. Espera un momento e inténtalo de nuevo."}}';
    }

    # "^~" hace que estas rutas ganen sobre la regla de archivos .css/.js de
    # abajo (así Swagger en /api/docs y /auth/docs carga sus estilos y scripts).

    # ---------- Microservicio 1: autenticación ----------
    # Inicio de sesión y registro: límite más estricto (además del de ms-auth)
    location = /auth/login {
        limit_req zone=eduplan_acceso burst=10 nodelay;
        proxy_pass http://ms-auth:3001;
    }
    location = /auth/registro {
        limit_req zone=eduplan_acceso burst=10 nodelay;
        proxy_pass http://ms-auth:3001;
    }

    location ^~ /auth/ {
        limit_req zone=eduplan_api burst=60 nodelay;
        proxy_pass http://ms-auth:3001;
    }

    # ---------- Microservicio 2: académico e IA ----------
    location ^~ /api/ {
        limit_req zone=eduplan_api burst=60 nodelay;
        proxy_pass http://ms-academico:3002;
        # Las respuestas de la IA (planes, cuestionarios) pueden tardar
        proxy_read_timeout 120s;
    }

    # ---------- Frontend ----------
    location /fuentes/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/eduplan-seguridad.conf;
    }

    location ~* \.(css|js|svg)$ {
        # Revalida en cada visita para que los cambios se vean de inmediato
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/eduplan-seguridad.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" always;
        include /etc/nginx/snippets/eduplan-seguridad.conf;
    }
}
